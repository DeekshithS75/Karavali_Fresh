NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MOBILE_ORIGIN=*

# Required backend secrets: generate independent random values; never commit actual values.
TOKEN_HMAC_SECRET=replace-with-at-least-32-random-bytes
PHONE_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
AADHAAR_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
AADHAAR_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key

# NaCaller Miss OTP API key. Keep it only in this backend environment.
NACALLER_KEY=

# OCR is local Tesseract.js (English + Kannada) with bundled trained-data packages.

PRIVACY_NOTICE_VERSION=farmer-registration-phone-v2
PRIVACY_NOTICE_EN=Your details and document are processed for farmer registration and document comparison. OCR is not proof of identity; control of the supplied phone number is checked separately through a missed call.
PRIVACY_NOTICE_KN=ರೈತರ ನೋಂದಣಿ ಮತ್ತು ದಾಖಲೆ ಹೋಲಿಕೆಗಾಗಿ ನಿಮ್ಮ ವಿವರಗಳನ್ನು ಸಂಸ್ಕರಿಸಲಾಗುತ್ತದೆ. OCR ಗುರುತಿನ ಪುರಾವೆಯಲ್ಲ; ನೀಡಿದ ಫೋನ್ ಸಂಖ್ಯೆಯ ಬಳಕೆಯನ್ನು ಮಿಸ್ಡ್ ಕಾಲ್ ಮೂಲಕ ಪ್ರತ್ಯೇಕವಾಗಿ ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ.
PRIVACY_NOTICE_TCY=
PHONE_VERIFICATION_TTL_SECONDS=300
PHONE_VERIFICATION_RESEND_SECONDS=60
SESSION_TTL_SECONDS=2592000
REGISTRATION_TTL_HOURS=24
