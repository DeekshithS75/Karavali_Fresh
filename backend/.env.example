NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MOBILE_ORIGIN=*

# Required secrets: generate independent random values; never commit actual values.
TOKEN_HMAC_SECRET=replace-with-at-least-32-random-bytes
OTP_HMAC_SECRET=replace-with-at-least-32-random-bytes
AADHAAR_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
AADHAAR_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key

# OCR is local Tesseract.js (English + Kannada) with bundled trained-data packages.
OCR_TEST_MODE_ENABLED=false

# Separate OTP delivery integration: POST { phone, code, purpose } over HTTPS.
OTP_DELIVERY_URL=
OTP_DELIVERY_API_KEY=

PRIVACY_NOTICE_VERSION=farmer-registration-v1
PRIVACY_NOTICE_EN=Your details and document are processed for farmer registration and document comparison. OCR is not proof of identity; phone ownership is checked separately by OTP.
PRIVACY_NOTICE_KN=ರೈತರ ನೋಂದಣಿ ಮತ್ತು ದಾಖಲೆ ಹೋಲಿಕೆಗಾಗಿ ನಿಮ್ಮ ವಿವರಗಳನ್ನು ಸಂಸ್ಕರಿಸಲಾಗುತ್ತದೆ. OCR ಗುರುತಿನ ಪುರಾವೆಯಲ್ಲ; OTP ಮೂಲಕ ಫೋನ್ ಬಳಕೆಯನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಪರಿಶೀಲಿಸಲಾಗುತ್ತದೆ.
PRIVACY_NOTICE_TCY=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
SESSION_TTL_SECONDS=2592000
REGISTRATION_TTL_HOURS=24
